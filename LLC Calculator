function drawWave() { /* same as original */ var cv=setupC('c-wave',400); if(!cv)return; var ctx=cv.ctx,W=cv.W,H_=cv.H; var wfs=[{lbl:'Vab',unit:'V',col:'#2563eb',pk:S.Vbus_nom,fn:function(t){return t<.5?1:-1;},sq:true},{lbl:'ILr',unit:'A',col:'#16a34a',pk:S.Ir_pk,fn:function(t){return Math.sin(2*Math.PI*t);}},{lbl:'ILm',unit:'A',col:'#7c3aed',pk:S.ILm_pk,fn:function(t){return -Math.cos(2*Math.PI*t)*0.45+0.05;}},{lbl:'Is (sec)',unit:'A',col:'#d97706',pk:S.Ir_pk*S.n,fn:function(t){return Math.abs(Math.sin(2*Math.PI*t));},shade:true},{lbl:'Vout',unit:'V',col:'#16a34a',pk:S.vout,fn:function(t){return 1-.022*Math.abs(Math.cos(4*Math.PI*t));}},]; var rH=(H_-28)/wfs.length; var pad={l:80,r:18,t:8}; var pw=W-pad.l-pad.r,N=700; wfs.forEach(function(wf,ri){var cy=pad.t+ri*rH+rH*.5,amp=rH*.37; if(ri%2===0){ctx.fillStyle='rgba(0,0,0,.015)';ctx.fillRect(pad.l,pad.t+ri*rH,pw,rH);} ctx.strokeStyle='rgba(0,0,0,.06)';ctx.lineWidth=.6; ctx.beginPath();ctx.moveTo(pad.l,cy);ctx.lineTo(pad.l+pw,cy);ctx.stroke(); if(wf.shade){ctx.beginPath(); for(var j=0;j<=N;j++){var t=j/N,x=pad.l+t*pw,y=cy-wf.fn(t)*amp; j===0?ctx.moveTo(x,y):ctx.lineTo(x,y);} ctx.lineTo(pad.l+pw,cy);ctx.lineTo(pad.l,cy);ctx.closePath(); ctx.fillStyle='rgba(217,119,6,.08)';ctx.fill();} ctx.beginPath();ctx.strokeStyle=wf.col;ctx.lineWidth=1.8; var prev=null; for(var j=0;j<=N;j++){var t=j/N,v=wf.fn(t),x=pad.l+t*pw,y=cy-v*amp; if(wf.sq&&prev&&Math.abs(v-prev.v)>.5){ctx.lineTo(x,cy-prev.v*amp);ctx.lineTo(x,y);} j===0?ctx.moveTo(x,y):ctx.lineTo(x,y);prev={v:v};} ctx.stroke(); ctx.fillStyle=wf.col;ctx.font='bold 10px sans-serif';ctx.textAlign='right'; ctx.fillText(wf.lbl,pad.l-6,cy-amp*.3); ctx.fillStyle='rgba(0,0,0,.3)';ctx.font='9px monospace';ctx.textAlign='right'; var pk=wf.pk>=100?wf.pk.toFixed(1):wf.pk.toFixed(3); ctx.fillText('pk='+pk,pad.l-6,cy+amp*.7);}); ctx.fillStyle='rgba(0,0,0,.3)';ctx.font='10px sans-serif';ctx.textAlign='center'; ctx.fillText('← T = '+(1/S.fr_k*1000).toFixed(2)+'µs  →  ripple @ '+(2*S.fr_k)+'kHz',pad.l+pw/2,H_-5); ctx.strokeStyle='rgba(0,0,0,.08)';ctx.lineWidth=.8;ctx.setLineDash([2,2]); ctx.beginPath();ctx.moveTo(pad.l+pw/2,pad.t);ctx.lineTo(pad.l+pw/2,H_-20);ctx.stroke(); ctx.setLineDash([]);}
function drawOp() { /* same */ var cv=setupC('c-op',380);if(!cv)return; var ctx=cv.ctx,W=cv.W,H_=cv.H; var pad={l:48,r:18,t:22,b:50}; var pw=W-pad.l-pad.r,ph=H_-pad.t-pad.b; var xMin=0.2,xMax=2.0,yMax=3.0; var xS=function(x){return pad.l+(x-xMin)/(xMax-xMin)*pw;}; var yS=function(y){return pad.t+ph-Math.min(Math.max(y,0),yMax)/yMax*ph;}; drawGrid(ctx,pad,pw,ph,xMin,xMax,yMax,9,6,'Fn = fsw / fr','Tank gain |H|',null); ctx.fillStyle='rgba(22,163,74,.05)'; ctx.fillRect(xS(S.Fxmin),pad.t,xS(xMax)-xS(S.Fxmin),ph); ctx.beginPath();ctx.strokeStyle='#2563eb';ctx.lineWidth=2.5; var started=false; for(var i=0;i<=500;i++){var Fx=xMin+i*(xMax-xMin)/500,h=H(Fx,S.Q,S.m); var x=xS(Fx),y=yS(h); if(y<pad.t-8||y>pad.t+ph+8){started=false;continue;} if(!started){ctx.moveTo(x,y);started=true;}else ctx.lineTo(x,y);} ctx.stroke(); ctx.beginPath();ctx.strokeStyle='#bfdbfe';ctx.lineWidth=1;started=false; for(var i=0;i<=500;i++){var Fx=xMin+i*(xMax-xMin)/500,h=H(Fx,0.05,S.m); var x=xS(Fx),y=yS(h); if(y<pad.t-8||y>pad.t+ph+8){started=false;continue;} if(!started){ctx.moveTo(x,y);started=true;}else ctx.lineTo(x,y);} ctx.stroke(); ctx.setLineDash([4,3]);ctx.strokeStyle='#d97706';ctx.lineWidth=1.2; ctx.beginPath();ctx.moveTo(xS(S.Fxmin),pad.t);ctx.lineTo(xS(S.Fxmin),pad.t+ph);ctx.stroke(); ctx.setLineDash([]); var vinPts=[{label:'Vin_min='+S.vinmin+'V', Vbus:S.Vbus_min, col:'#dc2626'},{label:'Vin_nom='+S.vinnom+'V', Vbus:S.Vbus_nom, col:'#16a34a'},{label:'Vin_max='+(S.vinnom*1.2).toFixed(0)+'V', Vbus:S.Vbus_max, col:'#9aa2b4'}]; vinPts.forEach(function(vp,vi){var H_need=S.vout*S.n/vp.Vbus; if(H_need<=0||H_need>yMax*1.1)return; var bFx=1.0,bErr=999; for(var i=0;i<=4000;i++){var Fx=0.2+i*(xMax-0.2)/4000; var err=Math.abs(H(Fx,S.Q,S.m)-H_need); if(err<bErr){bErr=err;bFx=Fx;}} var inZVS=bFx>=S.Fxmin; if(H_need<=yMax){ctx.setLineDash([3,3]);ctx.strokeStyle=vp.col;ctx.lineWidth=.9;ctx.globalAlpha=.6; ctx.beginPath();ctx.moveTo(pad.l,yS(H_need));ctx.lineTo(pad.l+pw,yS(H_need));ctx.stroke(); ctx.setLineDash([]);ctx.globalAlpha=1;} var h_op=H(bFx,S.Q,S.m); var x=xS(bFx),y=yS(h_op); if(y>=pad.t-5&&y<=pad.t+ph+5){ctx.setLineDash([2,2]);ctx.strokeStyle=vp.col;ctx.lineWidth=.7;ctx.globalAlpha=.4; ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x,pad.t+ph);ctx.stroke(); ctx.setLineDash([]);ctx.globalAlpha=1; ctx.beginPath();ctx.arc(x,y,5,0,2*Math.PI); ctx.fillStyle=vp.col;ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.stroke(); ctx.fillStyle=vp.col;ctx.font='9px sans-serif';ctx.textAlign='center'; ctx.fillText(vp.label,x,y-9); ctx.fillStyle='rgba(0,0,0,.4)';ctx.font='9px monospace';ctx.textAlign='center'; ctx.fillText('Fn='+bFx.toFixed(3),x,pad.t+ph+16+vi*11); ctx.fillStyle=inZVS?'#16a34a':'#dc2626';ctx.font='bold 9px sans-serif'; ctx.fillText(inZVS?'ZVS':'NO ZVS',x,pad.t+ph+27+vi*11);}});}
function drawZVS() { /* same */ var cv=setupC('c-zvs',380);if(!cv)return; var ctx=cv.ctx,W=cv.W,H_=cv.H; var pad={l:60,r:60,t:22,b:38}; var pw=W-pad.l-pad.r,ph=H_-pad.t-pad.b; var mMin=2,mMax=12; var mArr=[],ILmArr=[],tdArr=[]; for(var mi=mMin;mi<=mMax;mi+=0.1){var Lr_i=S.Zr/(2*Math.PI*S.fr); var Lm_i=(mi-1)*Lr_i; var ilm=S.Vbus_nom/(4*Lm_i*S.fr); var td=S.Ceq>0&&ilm>0?Math.PI*S.Ceq*S.Vbus_nom/ilm:9999; mArr.push(mi);ILmArr.push(ilm*1e3);tdArr.push(Math.min(td*1e9,2000));} var ILm_max=Math.max.apply(null,ILmArr)*1.15; var td_max=2000; var xS=function(m){return pad.l+(m-mMin)/(mMax-mMin)*pw;}; var yL=function(v){return pad.t+ph-Math.min(v/ILm_max,1)*ph;}; var yR=function(v){return pad.t+ph-Math.min(v/td_max,1)*ph;}; ctx.strokeStyle='rgba(0,0,0,.06)';ctx.lineWidth=.7; for(var i=0;i<=5;i++){var y=pad.t+i*ph/5;ctx.beginPath();ctx.moveTo(pad.l,y);ctx.lineTo(pad.l+pw,y);ctx.stroke();} for(var i=mMin;i<=mMax;i+=2){var x=xS(i);ctx.beginPath();ctx.moveTo(x,pad.t);ctx.lineTo(x,pad.t+ph);ctx.stroke();} ctx.beginPath();ctx.strokeStyle='#7c3aed';ctx.lineWidth=2; for(var i=0;i<mArr.length;i++){var x=xS(mArr[i]),y=yL(ILmArr[i]); i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);}ctx.stroke(); ctx.beginPath();ctx.strokeStyle='#d97706';ctx.lineWidth=2; for(var i=0;i<mArr.length;i++){var x=xS(mArr[i]),y=yR(tdArr[i]); i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);}ctx.stroke(); var y_dt=yR(Math.min(S.dt_ns,td_max)); ctx.setLineDash([4,4]);ctx.strokeStyle='#16a34a';ctx.lineWidth=1.5; ctx.beginPath();ctx.moveTo(pad.l,y_dt);ctx.lineTo(pad.l+pw,y_dt);ctx.stroke(); ctx.setLineDash([]); ctx.fillStyle='#16a34a';ctx.font='9px sans-serif';ctx.textAlign='right'; ctx.fillText('tdead='+S.dt_ns+'ns',pad.l+pw-3,y_dt-3); var mIdx=Math.round((S.m-mMin)/0.1); mIdx=Math.max(0,Math.min(mIdx,mArr.length-1)); ctx.beginPath();ctx.arc(xS(S.m),yL(ILmArr[mIdx]),5,0,2*Math.PI); ctx.fillStyle='#7c3aed';ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.stroke(); ctx.beginPath();ctx.arc(xS(S.m),yR(tdArr[mIdx]),5,0,2*Math.PI); ctx.fillStyle='#d97706';ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.stroke(); ctx.setLineDash([3,3]);ctx.strokeStyle='rgba(0,0,0,.15)';ctx.lineWidth=1; ctx.beginPath();ctx.moveTo(xS(S.m),pad.t);ctx.lineTo(xS(S.m),pad.t+ph);ctx.stroke(); ctx.setLineDash([]); ctx.fillStyle='rgba(0,0,0,.4)';ctx.font='10px sans-serif';ctx.textAlign='center'; for(var i=mMin;i<=mMax;i+=2)ctx.fillText(i,xS(i),pad.t+ph+16); ctx.fillText('m = (Lr+Lm)/Lr',pad.l+pw/2,H_-5); ctx.fillStyle='#7c3aed';ctx.textAlign='right'; for(var i=0;i<=5;i++){var v=i*ILm_max/5;ctx.fillText(v.toFixed(0),pad.l-4,pad.t+ph-i*ph/5+4);} ctx.fillStyle='#d97706';ctx.textAlign='left'; for(var i=0;i<=5;i++){var v=i*td_max/5;ctx.fillText(v.toFixed(0),pad.l+pw+4,pad.t+ph-i*ph/5+4);} ctx.fillStyle='#7c3aed';ctx.font='bold 10px sans-serif';ctx.textAlign='left'; ctx.fillText('ILm_pk (mA)',pad.l,pad.t-7); ctx.fillStyle='#d97706';ctx.textAlign='right'; ctx.fillText('tdead_min (ns)',pad.l+pw,pad.t-7); document.getElementById('zvs-note').innerHTML = '<b style="color:#7c3aed">Purple=ILm_pk</b>, <b style="color:#d97706">orange=tdead needed</b>, <b style="color:#16a34a">green=available tdead</b>. At m='+S.m.toFixed(1)+': ILm_pk='+ILmArr[mIdx].toFixed(0)+'mA, tdead_min='+tdArr[mIdx].toFixed(0)+'ns. '+(S.zvs_ok?'<b style="color:#16a34a">ZVS OK</b>':S.zvs_marg?'<b style="color:#d97706">Marginal — increase tdead or reduce m</b>':'<b style="color:#dc2626">ZVS FAILS — increase tdead or reduce m</b>');}

function redraw() { if (!S.fr) return; if (curTab==='gain') drawGain(); else if (curTab==='wave') drawWave(); else if (curTab==='op') drawOp(); else if (curTab==='zvs') drawZVS(); }

window.addEventListener('load', function() { renderSchem(); upd(); });
window.addEventListener('resize', function() { clearTimeout(window._rt); window._rt = setTimeout(redraw, 120); });
