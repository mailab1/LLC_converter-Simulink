function setupC(id, H_px) {
  var c = document.getElementById(id);
  if (!c) return null;
  var dpr = window.devicePixelRatio || 1;
  var W   = c.offsetWidth;
  if (!W || W < 10) { W = 700; }
  c.width  = W * dpr;
  c.height = H_px * dpr;
  c.style.height = H_px + 'px';
  var ctx = c.getContext('2d');
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, W, H_px);
  return { ctx:ctx, W:W, H:H_px };
}

var QCOLS = ['#bfdbfe','#7dd3fc','#38bdf8','#0ea5e9','#0284c7','#0369a1','#1e40af','#1e3a8a'];
var QVALS = [0.1, 0.2, 0.3, 0.4, 0.6, 0.8, 1.0, 1.5];

function drawGrid(ctx, pad, pw, ph, xMin, xMax, yMax, xN, yN, xLbl, yLbl, xFunc) {
  ctx.strokeStyle = 'rgba(0,0,0,0.06)'; ctx.lineWidth = 0.7;
  for (var i=0; i<=yN; i++) { var y = pad.t + i*ph/yN; ctx.beginPath(); ctx.moveTo(pad.l,y); ctx.lineTo(pad.l+pw,y); ctx.stroke(); }
  for (var j=0; j<=xN; j++) { var x = pad.l + j*pw/xN; ctx.beginPath(); ctx.moveTo(x,pad.t); ctx.lineTo(x,pad.t+ph); ctx.stroke(); }
  ctx.fillStyle='rgba(0,0,0,0.4)'; ctx.font='10px sans-serif'; ctx.textAlign='center';
  for (var j=0; j<=xN; j++) {
    var v = xMin + j*(xMax-xMin)/xN;
    ctx.fillText(xFunc ? xFunc(v).toFixed(1) : v.toFixed(2), pad.l+j*pw/xN, pad.t+ph+16);
  }
  ctx.textAlign='right';
  for (var i=0; i<=yN; i++) { var v = (yN-i)*yMax/yN; ctx.fillText(v.toFixed(1), pad.l-5, pad.t+i*ph/yN+4); }
  ctx.textAlign='center'; ctx.fillStyle='rgba(0,0,0,0.5)';
  if (xLbl) ctx.fillText(xLbl, pad.l+pw/2, pad.t+ph+28);
  if (yLbl) { ctx.save(); ctx.translate(12, pad.t+ph/2); ctx.rotate(-Math.PI/2); ctx.fillText(yLbl, 0, 0); ctx.restore(); }
}

