// GAIN CURVES WITH ACTUAL FREQUENCY (kHz) X-AXIS
// ═══════════════════════════════════════════════════════════
function drawGain() {
  var cv = setupC('c-gain', 380); if (!cv) return;
  var ctx=cv.ctx, W=cv.W, H_=cv.H;
  var pad={l:48,r:18,t:22,b:50};
  var pw=W-pad.l-pad.r, ph=H_-pad.t-pad.b;
  var frk = S.fr_k;
  var fMin = 0.2 * frk, fMax = 2.0 * frk;
  var yMax = 3.0;
  function xFreq(f) { return pad.l + (f - fMin)/(fMax - fMin) * pw; }
  function yGain(g) { return pad.t + ph - Math.min(Math.max(g,0),yMax)/yMax * ph; }

  drawGrid(ctx, pad, pw, ph, fMin, fMax, yMax, 9, 6, 'Frequency (kHz)', 'Tank gain |H|', function(v){return v;});
  ctx.fillStyle='rgba(0,0,0,0.6)'; ctx.font='bold 11px sans-serif'; ctx.textAlign='left';
  ctx.fillText('m='+S.m.toFixed(1)+'  '+bridge.toUpperCase()+'  fr='+S.fr_k+'kHz', pad.l+2, pad.t-7);

  var f_shade_start = S.fsw_min;
  if (f_shade_start < fMax) {
    ctx.fillStyle='rgba(22,163,74,0.05)';
    ctx.fillRect(xFreq(f_shade_start), pad.t, xFreq(fMax)-xFreq(f_shade_start), ph);
  }

  ctx.setLineDash([4,4]); ctx.strokeStyle='rgba(0,0,0,0.12)'; ctx.lineWidth=0.8;
  ctx.beginPath(); ctx.moveTo(pad.l, yGain(1)); ctx.lineTo(pad.l+pw, yGain(1)); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle='rgba(0,0,0,0.25)'; ctx.font='9px sans-serif'; ctx.textAlign='left';
  ctx.fillText('H=1',pad.l+3,yGain(1)-3);

  var N=500;
  for (var qi=0; qi<QVALS.length; qi++) {
    var q=QVALS[qi];
    var isActive = Math.abs(q-S.Q)<0.06;
    ctx.beginPath();
    ctx.strokeStyle = QCOLS[qi];
    ctx.lineWidth   = isActive ? 2.8 : 1.0;
    ctx.globalAlpha = isActive ? 1.0 : 0.45;
    var started=false;
    for (var i=0; i<=N; i++) {
      var f = fMin + i*(fMax-fMin)/N;
      var Fn = f / frk;
      var h = H(Fn, q, S.m);
      var x = xFreq(f), y = yGain(h);
      if (y<pad.t-8||y>pad.t+ph+8){started=false;continue;}
      if (!started){ctx.moveTo(x,y);started=true;}else ctx.lineTo(x,y);
    }
    ctx.stroke(); ctx.globalAlpha=1;
  }

  if (S.H_need_min<=yMax) {
    ctx.setLineDash([5,3]); ctx.strokeStyle='#dc2626'; ctx.lineWidth=1.6;
    ctx.beginPath(); ctx.moveTo(pad.l,yGain(S.H_need_min)); ctx.lineTo(pad.l+pw,yGain(S.H_need_min)); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle='#dc2626'; ctx.font='9px sans-serif'; ctx.textAlign='right';
    ctx.fillText('H_req='+S.H_need_min.toFixed(3), pad.l+pw-3, yGain(S.H_need_min)-3);
  }

  ctx.setLineDash([4,3]); ctx.strokeStyle='#d97706'; ctx.lineWidth=1.2;
  var x_fswmin = xFreq(S.fsw_min);
  ctx.beginPath(); ctx.moveTo(x_fswmin,pad.t); ctx.lineTo(x_fswmin,pad.t+ph); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle='#d97706'; ctx.font='9px sans-serif'; ctx.textAlign='left';
  ctx.fillText('fsw_min='+S.fsw_min.toFixed(1)+'kHz', x_fswmin+3, pad.t+12);

  ctx.beginPath(); ctx.arc(x_fswmin, yGain(S.Hmax), 5, 0, 2*Math.PI);
  ctx.fillStyle='#d97706'; ctx.fill(); ctx.strokeStyle='#fff'; ctx.lineWidth=1.5; ctx.stroke();
  ctx.fillStyle='#d97706'; ctx.font='9px sans-serif'; ctx.textAlign='left';
  ctx.fillText('Hmax='+S.Hmax.toFixed(3), x_fswmin+8, yGain(S.Hmax)+4);

  var hop = H(1.0, S.Q, S.m);
  var x_fr = xFreq(S.fr_k);
  ctx.beginPath(); ctx.arc(x_fr, yGain(hop), 5, 0, 2*Math.PI);
  ctx.fillStyle='#16a34a'; ctx.fill(); ctx.strokeStyle='#fff'; ctx.lineWidth=1.5; ctx.stroke();
  ctx.fillStyle='#16a34a'; ctx.font='bold 9px sans-serif'; ctx.textAlign='right';
  ctx.fillText('H(Fn=1)='+hop.toFixed(3), x_fr-8, yGain(hop)-5);

  ctx.setLineDash([2,2]); ctx.strokeStyle='rgba(0,0,0,0.12)'; ctx.lineWidth=0.8;
  ctx.beginPath(); ctx.moveTo(x_fr,pad.t); ctx.lineTo(x_fr,pad.t+ph); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle='rgba(22,163,74,0.7)'; ctx.font='9px sans-serif'; ctx.textAlign='left';
  ctx.fillText('◀ ZVS region', x_fswmin+5, pad.t+ph-6);

  var leg=document.getElementById('gain-leg');
  leg.innerHTML = QVALS.map(function(q,i){
    return '<div class="leg-item"><div class="leg-dot" style="background:'+QCOLS[i]+';opacity:'+(Math.abs(q-S.Q)<0.06?1:0.45)+'"></div>Q='+q+'</div>';
  }).join('')
  +'<div class="leg-item"><div class="leg-dot" style="background:#dc2626;height:2px;border-top:1px dashed #dc2626"></div>H required</div>'
  +'<div class="leg-item" style="gap:4px"><div style="width:9px;height:9px;border-radius:50%;background:#d97706"></div>Hmax</div>'
  +'<div class="leg-item" style="gap:4px"><div style="width:9px;height:9px;border-radius:50%;background:#16a34a"></div>Op.pt Fn=1</div>';
  document.getElementById('gain-note').innerHTML =
    '<b>fsw_min='+S.fsw_min.toFixed(1)+'kHz</b> (ZVS boundary). '
    +'Hmax='+S.Hmax.toFixed(4)+' vs H_req='+S.H_need_min.toFixed(4)+'. '
    +'All curves cross H=1 at fr='+S.fr_k+'kHz ✓';
}

